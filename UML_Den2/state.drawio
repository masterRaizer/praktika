<mxCell id="Booked" value="&lt;p style=&quot;margin:0px;margin-top:8px;text-align:center;&quot;&gt;&lt;b style=&quot;font-size:15px&quot;&gt;Забронирован&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:10px;font-size:12px&quot;&gt;entry / заблокировать места&lt;br&gt;do / отсчёт 15 минут брони&lt;br&gt;применён промокод / пересчитать сумму&lt;/p&gt;" style="rounded=1;arcSize=14;verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fillColor=#F3F7FC;strokeColor=#2B4C7E;strokeWidth=1.8;fontFamily=DejaVu Sans;fontColor=#1F2937;" vertex="1" parent="1"><mxGeometry x="75.0" y="218.0" width="310.0" height="104.0" as="geometry"/></mxCell>
<mxCell id="Paying" value="&lt;p style=&quot;margin:0px;margin-top:8px;text-align:center;&quot;&gt;&lt;b style=&quot;font-size:15px&quot;&gt;Оплачивается&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:10px;font-size:12px&quot;&gt;entry / отправить платёж в банк&lt;br&gt;do / ждать ответа платёжной системы&lt;/p&gt;" style="rounded=1;arcSize=14;verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;fillColor=#F3F7FC;strokeColor=#2B4C7E;strokeWidth=1.8;fontFamily=DejaVu Sans;fontColor=#1F2937;" vertex="1" parent="1"><mxGeometry x="545.0" y="227.0" width="310.0" height="86.0" as="geometry"/></mxCell>
