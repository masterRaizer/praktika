<mxfile host="app.diagrams.net"><diagram name="Навигация между формами приложения «Киноточка»"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" pageWidth="1580" pageHeight="960"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n2" value="Запуск программы" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fontStyle=1;fillColor=#1F2937;strokeColor=#1F2937;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="170" y="90" width="180" height="46" as="geometry"/></mxCell><mxCell id="n3" value="&lt;b&gt;Форма 1. Вход&lt;/b&gt;&lt;hr&gt;эл. почта и пароль,&lt;br&gt;проверка подключения&lt;br&gt;к базе данных" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;fillColor=#FFFFFF;strokeColor=#2B4C7E;" vertex="1" parent="1"><mxGeometry x="140" y="200" width="240" height="120" as="geometry"/></mxCell><mxCell id="n4" value="&lt;b&gt;Форма 2. Регистрация&lt;/b&gt;&lt;hr&gt;новый зритель,&lt;br&gt;пароль → хеш" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;fillColor=#FFFFFF;strokeColor=#2B4C7E;" vertex="1" parent="1"><mxGeometry x="140" y="430" width="240" height="100" as="geometry"/></mxCell><mxCell id="n5" value="&lt;b&gt;Форма 3. Подключение&lt;/b&gt;&lt;hr&gt;имя сервера SQL Server,&lt;br&gt;кнопка «Проверить»" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;fillColor=#FFFFFF;strokeColor=#2B4C7E;" vertex="1" parent="1"><mxGeometry x="140" y="620" width="240" height="100" as="geometry"/></mxCell><mxCell id="n6" value="Выход из программы" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fontStyle=1;fillColor=#1F2937;strokeColor=#1F2937;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="170" y="840" width="180" height="46" as="geometry"/></mxCell><mxCell id="n7" value="&lt;b&gt;Форма 4. Главное окно&lt;/b&gt;&lt;hr&gt;боковая панель разделов:&lt;br&gt;• Главная — показатели, афиша&lt;br&gt;• Фильмы&lt;br&gt;• Сеансы&lt;br&gt;• Заказы / Мои заказы&lt;br&gt;• Пользователи (администратор)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;fillColor=#FFFFFF;strokeColor=#2B4C7E;" vertex="1" parent="1"><mxGeometry x="540" y="180" width="310" height="220" as="geometry"/></mxCell><mxCell id="n8" value="&lt;b&gt;Сообщение об ошибке&lt;/b&gt;&lt;hr&gt;понятный текст на русском,&lt;br&gt;«Подробнее» — номер ошибки&lt;br&gt;без паролей и строки подключения" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;fillColor=#FFFFFF;strokeColor=#B4234A;" vertex="1" parent="1"><mxGeometry x="540" y="600" width="310" height="110" as="geometry"/></mxCell><mxCell id="n9" value="&lt;b&gt;Форма 5. Фильм&lt;/b&gt;&lt;hr&gt;добавление и изменение" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;fillColor=#FFFFFF;strokeColor=#2B4C7E;" vertex="1" parent="1"><mxGeometry x="990" y="90" width="260" height="80" as="geometry"/></mxCell><mxCell id="n10" value="&lt;b&gt;Форма 6. Сеанс&lt;/b&gt;&lt;hr&gt;добавление и изменение" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;fillColor=#FFFFFF;strokeColor=#2B4C7E;" vertex="1" parent="1"><mxGeometry x="990" y="200" width="260" height="80" as="geometry"/></mxCell><mxCell id="n11" value="&lt;b&gt;Форма 8. Статус заказа&lt;/b&gt;&lt;hr&gt;кассир, администратор" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;fillColor=#FFFFFF;strokeColor=#2B4C7E;" vertex="1" parent="1"><mxGeometry x="990" y="310" width="260" height="80" as="geometry"/></mxCell><mxCell id="n12" value="&lt;b&gt;Форма 7. Пользователь&lt;/b&gt;&lt;hr&gt;только администратор" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;fillColor=#FFFFFF;strokeColor=#2B4C7E;" vertex="1" parent="1"><mxGeometry x="990" y="420" width="260" height="80" as="geometry"/></mxCell><mxCell id="n13" value="&lt;b&gt;Подтверждение&lt;/b&gt;&lt;hr&gt;удаление записи,&lt;br&gt;блокировка, выход;&lt;br&gt;запрет при связанных данных" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;fillColor=#FFFFFF;strokeColor=#2F7A47;" vertex="1" parent="1"><mxGeometry x="990" y="600" width="260" height="110" as="geometry"/></mxCell><mxCell id="n14" value="&lt;b&gt;Права ролей&lt;/b&gt;&lt;hr&gt;Зритель:&lt;br&gt;  Главная, Фильмы и Сеансы —&lt;br&gt;  просмотр, Мои заказы&lt;br&gt;Кассир:&lt;br&gt;  + все заказы, смена статуса&lt;br&gt;Администратор:&lt;br&gt;  + добавление, изменение&lt;br&gt;  и удаление фильмов,&lt;br&gt;  сеансов, заказов;&lt;br&gt;  раздел Пользователи" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;fillColor=#FFFFFF;strokeColor=#2F7A47;" vertex="1" parent="1"><mxGeometry x="1290" y="90" width="270" height="300" as="geometry"/></mxCell><mxCell id="e15" value="" style="edgeStyle=none;html=1;endArrow=block;fontSize=11;" edge="1" parent="1" source="n2" target="n3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e16" value="«Регистрация»" style="edgeStyle=none;html=1;endArrow=block;fontSize=11;" edge="1" parent="1" source="n3" target="n4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e17" value="создан&#xa;аккаунт" style="edgeStyle=none;html=1;endArrow=block;fontSize=11;" edge="1" parent="1" source="n4" target="n3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e18" value="«Подключение»" style="edgeStyle=none;html=1;endArrow=block;fontSize=11;" edge="1" parent="1" source="n3" target="n5"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="100" y="290"/><mxPoint x="100" y="670"/></Array></mxGeometry></mxCell><mxCell id="e19" value="закрыть&#xa;окно" style="edgeStyle=none;html=1;endArrow=block;fontSize=11;dashed=1;" edge="1" parent="1" source="n3" target="n6"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="40" y="230"/><mxPoint x="40" y="863"/></Array></mxGeometry></mxCell><mxCell id="e20" value="вход выполнен" style="edgeStyle=none;html=1;endArrow=block;fontSize=11;" edge="1" parent="1" source="n3" target="n7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e21" value="«Выйти»" style="edgeStyle=none;html=1;endArrow=block;fontSize=11;" edge="1" parent="1" source="n7" target="n3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e22" value="нет подключения" style="edgeStyle=none;html=1;endArrow=block;fontSize=11;dashed=1;" edge="1" parent="1" source="n3" target="n8"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="470" y="305"/><mxPoint x="470" y="655"/></Array></mxGeometry></mxCell><mxCell id="e23" value="ошибка базы" style="edgeStyle=none;html=1;endArrow=block;fontSize=11;dashed=1;" edge="1" parent="1" source="n7" target="n8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e24" value="Добавить / Изменить" style="edgeStyle=none;html=1;endArrow=block;fontSize=11;" edge="1" parent="1" source="n7" target="n9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e25" value="" style="edgeStyle=none;html=1;endArrow=block;fontSize=11;" edge="1" parent="1" source="n7" target="n10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e26" value="Сменить статус" style="edgeStyle=none;html=1;endArrow=block;fontSize=11;" edge="1" parent="1" source="n7" target="n11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e27" value="" style="edgeStyle=none;html=1;endArrow=block;fontSize=11;" edge="1" parent="1" source="n7" target="n12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e28" value="Удалить" style="edgeStyle=none;html=1;endArrow=block;fontSize=11;" edge="1" parent="1" source="n7" target="n13"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="920" y="380"/><mxPoint x="920" y="655"/></Array></mxGeometry></mxCell><