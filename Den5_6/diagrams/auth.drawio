<mxfile host="app.diagrams.net"><diagram name="Алгоритм авторизации (AuthService.Login)"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" pageWidth="1100" pageHeight="1080"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n2" value="Начало" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fontStyle=1;fillColor=#1F2937;strokeColor=#1F2937;fontColor=#FFFFFF;" vertex="1" parent="1"><mxGeometry x="240" y="70" width="180" height="46" as="geometry"/></mxCell><mxCell id="n3" value="Ввод эл. почты и пароля" style="rounded=1;whiteSpace=wrap;html=1;fontStyle=1;fillColor=#DCE9FA;strokeColor=#2B4C7E;" vertex="1" parent="1"><mxGeometry x="180" y="150" width="300" height="60" as="geometry"/></mxCell><mxCell id="n4" value="Вход&lt;br&gt;приостановлен?" style="rhombus;whiteSpace=wrap;html=1;fontStyle=1;fillColor=#FFF7D6;strokeColor=#B67600;" vertex="1" parent="1"><mxGeometry x="200" y="245" width="260" height="90" as="geometry"/></mxCell><mxCell id="n5" value="Поля заполнены&lt;br&gt;и почта верна?" style="rhombus;whiteSpace=wrap;html=1;fontStyle=1;fillColor=#FFF7D6;strokeColor=#B67600;" vertex="1" parent="1"><mxGeometry x="200" y="370" width="260" height="90" as="geometry"/></mxCell><mxCell id="n6" value="SELECT … WHERE ЭлПочта = @ЭлПочта" style="rounded=1;whiteSpace=wrap;html=1;fontStyle=1;fillColor=#FDEBD3;strokeColor=#B45309;" vertex="1" parent="1"><mxGeometry x="160" y="495" width="340" height="60" as="geometry"/></mxCell><mxCell id="n7" value="Пользователь найден&lt;br&gt;и хеш совпал?" style="rhombus;whiteSpace=wrap;html=1;fontStyle=1;fillColor=#FFF7D6;strokeColor=#B67600;" vertex="1" parent="1"><mxGeometry x="200" y="590" width="260" height="90" as="geometry"/></mxCell><mxCell id="n8" value="Учётная запись&lt;br&gt;заблокирована?" style="rhombus;whiteSpace=wrap;html=1;fontStyle=1;fillColor=#FFF7D6;strokeColor=#B67600;" vertex="1" parent="1"><mxGeometry x="200" y="715" width="260" height="90" as="geometry"/></mxCell><mxCell id="n9" value="Открыть главное