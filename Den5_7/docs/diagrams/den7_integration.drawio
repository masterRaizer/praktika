<mxCell id="title" value="Интеграция модулей «Клиенты» и «Заявки» через REST API (день 7)" style="text;html=1;align=center;verticalAlign=middle;fontSize=22;fontStyle=1;fontColor=#1F2937;fontFamily=DejaVu Sans;" vertex="1" parent="1"><mxGeometry x="380.0" y="20" width="1000" height="36" as="geometry"/></mxCell>
<mxCell id="ui" value="&lt;b&gt;Окно Den5_7.exe — вкладки дня 7&lt;/b&gt;&lt;br&gt;&lt;i style=&quot;font-size:11px;color:#64748B&quot;&gt;HTTP-клиент: запуск модулей, клиенты, новая заявка, тесты&lt;/i&gt;" style="rounded=1;arcSize=7;absoluteArcSize=0;whiteSpace=wrap;html=1;fillColor=#E3EEFB;strokeColor=#2B4C7E;strokeWidth=1.6;fontSize=16;fontColor=#1F2937;spacingRight=4;fontFamily=DejaVu Sans;" vertex="1" parent="1"><mxGeometry x="640" y="90" width="480" height="110" as="geometry"/></mxCell>
<mxCell id="mc" value="GET  /api/health&lt;br&gt;GET  /api/clients&lt;br&gt;GET  /api/clients/{id}&lt;br&gt;GET  /api/clients/{id}/card&lt;br&gt;POST /api/clients" style="rounded=1;arcSize=2;absoluteArcSize=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5B3FA8;strokeWidth=1.6;fontSize=14;fontColor=#1F2937;spacingRight=4;fontFamily=DejaVu Sans;" vertex="1" parent="1"><mxGeometry x="60" y="340" width="560" height="330" as="geometry"/></mxCell>
<mxCell id="mr" value="GET  /api/health&lt;br&gt;GET  /api/requests[?clientId=]&lt;br&gt;GET  /api/requests/{id}&lt;br&gt;POST /api/requests" style="rounded=1;arcSize=2;absoluteArcSize=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#5B3FA8;strokeWidth=1.6;fontSize=14;fontColor=#1F2937;spacingRight=4;fontFamily=DejaVu Sans;" vertex="1" parent="1"><mxGeometry x="1140" y="340" width="560" height="330" as="geometry"/></mxCell>
