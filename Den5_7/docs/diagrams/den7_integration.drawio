<mxCell id="e4" value="" style="html=1;rounded=0;strokeColor=#475569;strokeWidth=1.6;fontFamily=DejaVu Sans;endArrow=block;endFill=1;endSize=10;exitX=0.0000;exitY=0.2727;exitDx=0;exitDy=0;entryX=1.0000;entryY=0.2727;entryDx=0;entryDy=0;" edge="1" parent="1" source="mr" target="mc"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="e4l0" value="1) перед созданием заявки: GET /api/clients/{clientId}&lt;br&gt;200 — клиент есть → 201; 404 → 422; нет ответа → 503" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=12;fontColor=#1F2937;labelBackgroundColor=#FFFFFF;fontFamily=DejaVu Sans;" vertex="1" connectable="0" parent="e4"><mxGeometry x="-1" relative="1" as="geometry"><mxPoint x="-260.0" y="-18.2" as="offset"/></mxGeometry></mxCell>
<mxCell id="e5" value="" style="html=1;rounded=0;strokeColor=#475569;strokeWidth=1.6;fontFamily=DejaVu Sans;endArrow=block;endFill=1;endSize=10;exitX=1.0000;exitY=0.7273;exitDx=0;exitDy=0;entryX=0.0000;entryY=0.7273;entryDx=0;entryDy=0;" edge="1" parent="1" source="mc" target="mr"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="e5l0" value="2) карточка клиента: GET /api/requests?clientId={id}&lt;br&gt;нет ответа → 503 «Модуль «Заявки» недоступен»" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=12;fontColor=#1F2937;labelBackgroundColor=#FFFFFF;fontFamily=DejaVu Sans;" vertex="1" connectable="0" parent="e5"><mxGeometry x="-1" relative="1" as="geometry"><mxPoint x="260.0" y="-18.2" as="offset"/></mxGeometry></mxCell>
<mxCell id="t0" value="Обмен — JSON в UTF-8; ошибки — {&quot;error&quot;: текст, &quot;status&quot;: код}. Каждый модуль — отдельный процесс на своём порту; при отказе одного другой продолжает работать." style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#64748B;fontFamily=DejaVu Sans;" vertex="1" parent="1"><mxGeometry x="60.0" y="829.2" width="1154.8" height="21.6" as="geometry"/></mxCell>
