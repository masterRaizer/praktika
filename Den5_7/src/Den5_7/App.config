<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <connectionStrings>
    <!-- База «Киноточка». Для SQL Server Express замените (localdb)\MSSQLLocalDB на .\SQLEXPRESS -->
    <add name="Киноточка"
         connectionString="Data Source=(localdb)\MSSQLLocalDB;Initial Catalog=Киноточка;Integrated Security=True;Connect Timeout=10"
         providerName="System.Data.SqlClient" />
  </connectionStrings>
  <appSettings>
    <!-- Порты модулей дня 7 (только локальный адрес 127.0.0.1) -->
    <add key="ClientsPort" value="5101" />
    <add key="RequestsPort" value="5102" />
  </appSettings>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
  </startup>
</configuration>
